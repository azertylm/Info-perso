# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALPHABETTE SOUVERAINETÉ & HYBRID AI ENGINE
# AI_PROVIDER: Mode du moteur IA ('gemini' | 'hybrid_mistral' | 'local' | 'mistral')
# Défaut en phase 1 de développement: gemini
AI_PROVIDER="gemini"

# MISTRAL_API_KEY: Clé officielle API Mistral AI (Paris/Europe - Secours souverain transparent)
MISTRAL_API_KEY=

# LOCAL_AI_URL: Endpoint du serveur local souverain (Ollama ou vLLM on-premise)
LOCAL_AI_URL="http://localhost:11434"

# LOCAL_AI_MODEL: Modèle open-source exécuté en local (ex: mistral-nemo, mistral-small)
LOCAL_AI_MODEL="mistral-nemo"

# LOCAL_AI_TIMEOUT_MS: Délai maximal avant bascule automatique vers Mistral Cloud (en ms)
LOCAL_AI_TIMEOUT_MS=3500

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
